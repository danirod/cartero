import gnuLinuxDark from "../../assets/main-screenshot/gnulinux-dark.png";
import gnuLinuxLight from "../../assets/main-screenshot/gnulinux-light.png";
import gnuLinuxDark2x from "../../assets/main-screenshot/gnulinux-dark@2x.png";
import gnuLinuxLight2x from "../../assets/main-screenshot/gnulinux-light@2x.png";
import macosDark from "../../assets/main-screenshot/macos-dark.png";
import macosLight from "../../assets/main-screenshot/macos-light.png";
import macosDark2x from "../../assets/main-screenshot/macos-dark@2x.png";
import macosLight2x from "../../assets/main-screenshot/macos-light@2x.png";
import windowsDark from "../../assets/main-screenshot/windows-dark.png";
import windowsLight from "../../assets/main-screenshot/windows-light.png";
import windowsDark2x from "../../assets/main-screenshot/windows-dark@2x.png";
import windowsLight2x from "../../assets/main-screenshot/windows-light@2x.png";
---

<div class="screenshot">
  <picture class="gnome">
    <source
      srcset={`${gnuLinuxDark.src}, ${gnuLinuxDark2x.src} 2x`}
      media="screen and (prefers-color-scheme: dark)"
    />
    <source srcset={`${gnuLinuxLight.src}, ${gnuLinuxLight2x.src} 2x`} />
    <img src={gnuLinuxLight.src} alt="A screenshot of Cartero" />
  </picture>
  <picture class="macos" hidden>
    <source
      srcset={`${macosDark.src}, ${macosDark2x.src} 2x`}
      media="screen and (prefers-color-scheme: dark)"
    />
    <source srcset={`${macosLight.src}, ${macosLight2x.src} 2x`} />
    <img src={macosLight.src} alt="A screenshot of Cartero" />
  </picture>
  <picture class="windows" hidden>
    <source
      srcset={`${windowsDark.src}, ${windowsDark2x.src} 2x`}
      media="screen and (prefers-color-scheme: dark)"
    />
    <source srcset={`${windowsLight.src}, ${windowsLight2x.src} 2x`} />
    <img src={windowsLight.src} alt="A screenshot of Cartero" />
  </picture>
</div>

<style>
  .screenshot {
    display: none;
  }

  @media screen and (min-width: 480px) {
    .screenshot {
      display: block;
      margin: 0 auto;
      justify-content: center;
    }

    .screenshot picture:not(.gnome) {
      display: none;
    }

    body.is-darwin .screenshot picture:not(.macos) {
      display: none;
    }
    body.is-darwin .screenshot picture.macos {
      display: block;
    }

    body.is-win32 .screenshot picture:not(.windows) {
      display: none;
    }
    body.is-win32 .screenshot picture.windows {
      display: block;
    }
  }

  .screenshot picture img {
    height: 400px;
    object-fit: cover;
    object-position: center top;
    width: 1160px;
    display: block;
  }

  .screenshot picture.macos img {
    width: 1262px;
    height: 438px;
    margin-top: -38px;
  }

  .screenshot picture.gnome img {
    width: 1210px;
    height: 425px;
    margin-top: -25px;
  }

  .screenshot picture.gnome img,
  .screenshot picture.macos img {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
  }
</style>
