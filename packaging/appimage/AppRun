#!/usr/bin/env bash

set -e

HERE="$(readlink -f "$(dirname "$0")")"

# Closely based on the AppRun generated by LinuxDeploy.
export GTK_DATA_PREFIX="$HERE"
export XDG_DATA_DIRS="$HERE/usr/share:/usr/share:$XDG_DATA_DIRS"
export GSETTINGS_SCHEMA_DIR="$HERE/usr/share/glib-2.0/schemas"
export GTK_EXE_PREFIX="$HERE/usr"
export GTK_PIXBUF_MODULE_FILE="$HERE/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache"
export FONTCONFIG_PATH=/etc/Fonts
export XKB_CONFIG_ROOT=/usr/share/X11/xkb
export QT_XKB_CONFIG_ROOT=/usr/share/X11/xkb

exec "$HERE/usr/bin/cartero" "$@"
