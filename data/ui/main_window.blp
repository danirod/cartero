using Gtk 4.0;
using Adw 1;

template $CarteroWindow: Adw.ApplicationWindow {
  title: "Cartero";
  width-request: 400;
  height-request: 500;

  Adw.Breakpoint {
    condition ("max-width: 500sp")

    setters {
      file_menu.visible: false;
    }
  }

  [content]
  Adw.ToolbarView {
    top-bar-style: raised;

    [top]
    Gtk.HeaderBar header_bar {
      title-widget: Adw.WindowTitle window_title {
        title: 'Cartero';
      };

      [start]
      Box file_menu {
        spacing: 5;

        Button {
          action-name: "win.new";
          icon-name: 'tab-new-symbolic';
          tooltip-text: _("New");
        }

        Separator {}

        Button open_dialog {
          styles [
            "flat",
          ]

          action-name: "win.open";
          tooltip-text: _("Open");

          [child]
          Box {
            spacing: 5;

            Image {
              accessible-role: presentation;
              icon-name: 'document-open-symbolic';
            }

            Label {
              label: _("Open");
            }
          }
        }

        Button save_dialog {
          action-name: "win.save";
          icon-name: 'document-save-symbolic';
          tooltip-text: _("Save");
        }
      }

      [end]
      Box {
        spacing: 5;

        MenuButton {
          tooltip-text: _("Export request");
          icon-name: "share-symbolic";
          menu-model: share_menu;
        }

        Separator {}

        MenuButton {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Menu");
          primary: true;
          menu-model: main_menu;
        }
      }
    }

    [top]
    Adw.TabBar tabs {
      view: tabview;
    }

    Stack stack {
      StackPage {
        name: "welcome";

        child: Adw.StatusPage {
          vexpand: true;
          title: _("Welcome to Cartero");
          description: _("Create or open a request and start testing APIs now.");
          icon-name: "es.danirod.Cartero-symbolic";

          child: Adw.Clamp {
            maximum-size: 500;

            Gtk.Box {
              orientation: vertical;

              Gtk.Button {
                styles [
                  "pill",
                  "suggested-action",
                ]

                action-name: "win.new";

                child: Adw.ButtonContent {
                  icon-name: "tab-new-symbolic";
                  label: _("New tab");
                };
              }

              Gtk.Button {
                styles [
                  "pill",
                ]

                action-name: "win.open";

                child: Adw.ButtonContent {
                  icon-name: "document-open-symbolic";
                  label: _("Open request…");
                };
              }
            }
          };
        };
      }

      StackPage {
        name: "tabview";

        child: Adw.TabView tabview {};
      }
    }
  }
}

menu share_menu {
  section {
    item {
      label: _("Export request as cURL…");
      action: "win.export-request";
      target: "curl";
    }
  }

  section {
    item {
      label: _("Export response body…");
      action: "win.export-response-body";
    }
  }
}

menu main_menu {
  section {
    item {
      label: _("New tab");
      action: "win.new";
    }

    item {
      label: _("Open request…");
      action: "win.open";
    }

    item {
      label: _("Save request");
      action: "win.save";
    }

    item {
      label: _("Save request as…");
      action: "win.save-as";
    }

    item {
      label: _("Close tab");
      action: "win.close";
    }
  }

  section {
    item {
      label: _("Settings");
      action: "app.preferences";
    }

    submenu {
      label: _("Body appearance");

      section {
        item {
          label: _("Wrap content");
          action: "win.body-wrap";
        }

        item {
          label: _("Show line numbers");
          action: "win.show-line-numbers";
        }
      }

      section {
        item {
          label: _("Automatic indentation");
          action: "win.auto-indent";
        }

        item {
          label: _("Indent with spaces");
          action: "win.indent-style";
          target: "spaces";
        }

        item {
          label: _("Indent with tabs");
          action: "win.indent-style";
          target: "tabs";
        }

        submenu {
          label: _("Spaces per tab");

          item {
            label: _("2");
            action: "win.tab-width";
            target: "2";
          }

          item {
            label: _("4");
            action: "win.tab-width";
            target: "4";
          }

          item {
            label: _("8");
            action: "win.tab-width";
            target: "8";
          }
        }
      }
    }
  }

  section {
    item {
      label: _("Keyboard shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("About Cartero");
      action: "win.about";
    }

    item {
      label: _("Quit");
      action: "app.quit";
    }
  }
}
