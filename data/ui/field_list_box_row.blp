using Gtk 4.0;

template $CarteroFieldListBoxRow: Gtk.Box {
  styles [
    "field-row",
  ]

  spacing: 5;

  Gtk.CheckButton active {
    tooltip-text: _("Enabled");
    sensitive: bind template.read-only inverted;
  }

  Gtk.Box {
    hexpand: true;

    Gtk.Overlay {
      hexpand: true;

      Gtk.Entry key {
        styles [
          "flat",
        ]

        editable: bind template.read-only inverted;
        placeholder-text: _("Name");
        tooltip-text: _("Name");
      }

      [overlay]
      Gtk.Image eye {
        styles [
          "override-eye",
        ]

        hexpand: false;
        vexpand: false;
        valign: center;
        halign: end;
        margin-end: 2;
        icon-name: "eye-not-looking-symbolic";
        tooltip-text: _("The value for this field will not be used because another field with the same name is overriding it.");
        visible: bind template.overriden;
      }
    }

    Gtk.Entry value {
      styles [
        "flat",
      ]

      editable: bind template.read-only inverted;
      hexpand: true;
      placeholder-text: _("Value");
      tooltip-text: _("Value");
    }

    Gtk.MenuButton {
      styles [
        "flat",
        "circular",
      ]

      tooltip-text: _("Actions");
      icon-name: "view-more-symbolic";
      sensitive: bind template.read-only inverted;
      menu-model: row_actions;
    }
  }
}

menu row_actions {
  section {
    item {
      label: _("Toggle secret");
      action: "row.toggle-secret";
      hidden-when: "action-disabled";
    }
  }

  section {
    item (_("Delete"), "row.delete")
  }
}
