using Gtk 4.0;
using Adw 1;

template $CarteroUrlencodedBodyPane: Adw.Bin {
  vexpand: false;
  valign: start;
  margin-bottom: 12;
  margin-start: 12;
  margin-top: 12;
  margin-end: 12;

  Gtk.Frame {
    $CarteroFieldTableListView {
      table: bind template.table;
      show-placeholder: true;
    }
  }
}
