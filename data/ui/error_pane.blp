using Gtk 4.0;
using Adw 1;

template $CarteroErrorPane: Adw.Bin {
  Adw.StatusPage {
    icon-name: bind template.icon;
    title: bind template.title;
    description: bind template.subtitle;

    child: Gtk.Label {
      label: bind template.extra;
      selectable: true;
      visible: bind $extra_visible(template.extra) as <bool>;
      opacity: 0.80;
      wrap: true;
    };
  }
}
