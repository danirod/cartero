<script is:inline>
  const ua = navigator.userAgent;
  if (ua.includes("Win")) {
    document.body.classList.add("is-win32");
  } else if (ua.includes("Mac")) {
    document.body.classList.add("is-darwin");
  } else {
    document.body.classList.add("is-gnome");
  }
</script>
