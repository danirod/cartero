<style>
  .colophon {
    background: var(--colophon-bg-color);
    color: var(--colophon-fg-color);
    font-size: 0.9em;
    text-align: center;
    padding: 3em;
  }

  .colophon a {
    color: var(--colophon-fg-color);
  }

  .socials {
        display: inline-flex;
        flex-direction: row;
        text-align: center;
        gap: 10px;
  }

  .socials a {
    color: var(--colophon-fg-color);
    text-decoration: none;
  }

  .socials svg {
        fill: currentColor;
  }
</style>
