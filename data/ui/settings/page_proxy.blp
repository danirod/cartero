using Gtk 4.0;
using Adw 1;

template $CarteroSettingsPageProxy: Adw.PreferencesPage {
  name: "proxy";
  title: _("Proxy");
  icon-name: "network-proxy-symbolic";

  Adw.PreferencesGroup {
    title: _("Proxy settings");

    Adw.EntryRow option_proxy_http {
      title: _("HTTP Proxy");
    }

    Adw.EntryRow option_proxy_https {
      title: _("HTTPS Proxy");
    }
  }

  Adw.PreferencesGroup {
    title: _("Exclude from proxy");
    description: _("IP addresses and domain names contained in this list will bypass the proxy settings and be accessed directly.");

    Gtk.Box {
      orientation: vertical;
      spacing: 3;

      Gtk.Box {
        styles [
          "linked",
        ]

        orientation: horizontal;
        hexpand: true;

        Gtk.Entry add_excluded {
          hexpand: true;
          tooltip-text: _("Address to exclude");
          placeholder-text: _("Address to exclude");
        }

        Gtk.Button {
          label: _("Add");
          action-name: "widget.add-excluded-host";
        }
      }

      Gtk.Revealer add_error_revealer {
        margin-bottom: 12;
        reveal-child: false;

        Gtk.Label add_error {
          styles [
            "caption",
            "error",
          ]

          wrap: true;
          hexpand: true;
          halign: start;
          label: _("");
        }
      }
    }

    Gtk.ListBox excluded_hosts_list {
      styles [
        "boxed-list",
      ]
    }
  }

  Adw.PreferencesGroup {
    title: _("Environment variables");
    // TRANSLATORS: Keep the variable names "http_proxy", "https_proxy" and "no_proxy" in English because that's the name of the variable.
    description: _("Cartero supports the use of the standard http_proxy, https_proxy and no_proxy environment variables to provide the system proxy settings.");

    Gtk.Box {
      orientation: vertical;
      spacing: 12;

      Gtk.ListBox {
        selection-mode: none;

        styles [
          "boxed-list",
        ]

        Adw.SwitchRow option_use_proxy_std {
          title: _("Use environment variables as a fallback");
          action-name: "widget.proxy-use-env";
        }
      }

      Gtk.ListBox {
        selection-mode: none;

        styles [
          "boxed-list",
        ]

        Adw.ActionRow option_std_http {
          styles [
            "property",
          ]

          focusable: false;
          selectable: false;
          title: "http_proxy";
          subtitle: _("(empty)");
        }

        Adw.ActionRow option_std_https {
          styles [
            "property",
          ]

          focusable: false;
          selectable: false;
          title: "https_proxy";
          subtitle: _("(empty)");
        }

        Adw.ActionRow option_std_no_proxy {
          styles [
            "property",
          ]

          focusable: false;
          selectable: false;
          title: "no_proxy";
          subtitle: _("(empty)");
        }
      }
    }
  }
}
