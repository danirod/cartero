using Gtk 4.0;
using Adw 1;

template $CarteroEndpointPane: $CarteroBasePane {
  width-request: 320;
  height-request: 480;

  Adw.Breakpoint {
    condition ("max-width: 820sp")

    setters {
      paned.orientation: vertical;
      request_pane.width-request: -1;
      request_pane.height-request: 170;
      response_pane.width-request: -1;
      response_pane.height-request: 170;
    }
  }

  ShortcutController shortcuts {
    scope: managed;
  }

  Box {
    orientation: vertical;

    Box {
      styles [
        "linked",
      ]

      margin-top: 6;
      margin-bottom: 6;
      margin-start: 6;
      margin-end: 6;
      orientation: horizontal;

      $CarteroMethodDropdown request_method {
        sensitive: bind template.read-only inverted;
      }

      Entry request_url {
        sensitive: bind template.read-only inverted;
        hexpand: true;
        placeholder-text: _("Request URL");
        tooltip-text: _("Request URL");
        changed => $on_url_changed() swapped;
        activate => $on_url_activated() swapped;
      }

      Button cancel {
        styles [
          "destructive-action",
        ]

        action-name: "endpoint.cancel";
        icon-name: "process-stop-symbolic";
        tooltip-text: _("Cancel request");
      }

      Button send {
        styles [
          "suggested-action",
        ]

        action-name: "endpoint.request";
        label: _("Send");
        tooltip-text: _("Execute this HTTP request");
      }
    }

    Separator {
      orientation: horizontal;
    }

    Paned paned {
      styles [
        "endpoint-pane",
        "background",
      ]

      orientation: horizontal;
      shrink-start-child: false;
      shrink-end-child: false;
      resize-start-child: true;
      resize-end-child: true;
      position: 500;

      start-child: Notebook request_pane {
        show-border: false;
        scrollable: true;
        width-request: 320;

        NotebookPage {
          tab: Label {
            label: _("Parameters");
          };

          child: ScrolledWindow {
            hexpand: true;
            vexpand: true;

            Gtk.Frame {
              vexpand: false;
              valign: start;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;

              $CarteroFieldTableListView parameter_pane {
                show-placeholder: true;
                read-only: bind template.read-only;
                changed => $on_parameters_change() swapped;
              }
            }
          };
        }

        NotebookPage {
          tab: Label {
            label: _("Headers");
          };

          child: ScrolledWindow {
            hexpand: true;
            vexpand: true;

            Gtk.Box {
              spacing: 12;
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;
              orientation: vertical;

              $CarteroCollapsedFieldTable pregenerated_headers {}

              Gtk.Frame {
                vexpand: false;
                valign: start;

                $CarteroFieldTableListView header_pane {
                  check-overriden: true;
                  check-overriden-icase: true;
                  read-only: bind template.read-only;
                  show-placeholder: true;
                }
              }
            }
          };
        }

        NotebookPage {
          tab: Label {
            label: _("Variables");
          };

          child: ScrolledWindow {
            hexpand: true;
            vexpand: true;

            Gtk.Box {
              margin-top: 12;
              margin-bottom: 12;
              margin-start: 12;
              margin-end: 12;
              spacing: 12;
              orientation: vertical;

              Gtk.Stack env_file_status {
                vhomogeneous: false;

                Gtk.StackPage {
                  name: "env-disabled";

                  child: Gtk.ListBox {
                    styles [
                      "boxed-list",
                    ]

                    Adw.ActionRow {
                      selectable: false;
                      focusable: false;
                      title: _("Cartero supports reading variables from an .env file, but you need to enable the feature first.");

                      Gtk.Button {
                        valign: center;
                        vexpand: false;
                        action-name: "app.preferences-page";
                        action-target: "'security'";
                        label: _("Settings");
                        margin-start: 12;
                      }
                    }
                  };
                }

                Gtk.StackPage {
                  name: "unsaved-file";

                  child: Gtk.ListBox {
                    styles [
                      "boxed-list",
                    ]

                    Adw.ActionRow {
                      selectable: false;
                      focusable: false;
                      title: _("Cartero supports reading variables from an .env file, but you have to save the request first.");
                    }
                  };
                }

                Gtk.StackPage {
                  name: "not-found";

                  child: Gtk.ListBox {
                    styles [
                      "boxed-list",
                    ]

                    Adw.ActionRow {
                      selectable: false;
                      focusable: false;
                      title: _("Place an .env file in the same disk directory as the request or in a parent directory to load the variables in Cartero.");

                      Gtk.Button {
                        valign: center;
                        vexpand: false;
                        action-name: "endpoint.reload-env";
                        label: _("Check again");
                        margin-start: 12;
                      }
                    }
                  };
                }

                Gtk.StackPage {
                  name: "toggle";

                  child: $CarteroCollapsedFieldTable env_variables {};
                }
              }

              Gtk.Frame {
                vexpand: false;
                valign: start;

                $CarteroFieldTableListView variable_pane {
                  check-overriden: true;
                  read-only: bind template.read-only;
                  show-placeholder: true;
                }
              }
            }
          };
        }

        NotebookPage {
          tab: Label {
            label: _("Authorization");
          };

          child: ScrolledWindow {
            hexpand: true;
            vexpand: true;

            $CarteroAuthenticationPane authentication_pane {
              read-only: bind template.read-only;
            }
          };
        }

        NotebookPage {
          tab: Label {
            label: _("Body");
          };

          child: ScrolledWindow {
            hexpand: true;
            vexpand: true;

            $CarteroRequestBodyPane body_pane {
              read-only: bind template.read-only;
            }
          };
        }
      };

      end-child: $CarteroResponsePanel response_pane {};
    }
  }
}
