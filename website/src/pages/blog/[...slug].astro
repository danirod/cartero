import { type CollectionEntry, getCollection, render } from "astro:content";
import InnerPage from "../../layouts/InnerPage.astro";
import { SITE_TITLE } from "../../consts";
import FormattedDate from "../../components/FormattedDate.astro";
import PostFooter from "../../components/atom/PostFooter.astro";
import fallbackImage from "../../assets/social/banner-16-9.jpg";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);
---

<InnerPage
  title={`${post.data.title} - ${SITE_TITLE}`}
  description={post.data.description}
  image={post.data.heroImage || fallbackImage}
>
  <div class="clamp blogpost">
    <header>
      {post.data.heroImage && <Image src={post.data.heroImage} alt={post.data.title} className="image" />}
      <h1>{post.data.title}</h1>
      <p class="date">
        Published on <FormattedDate date={post.data.pubDate} />
      </p>
    </header>
    <Content />
    <PostFooter />
  </div>
</InnerPage>

<style>
  .date {
    font-size: 0.9em;
  }

  header .image {
    margin-top: 3rem;
    width: 100%;
    height: 250px;
    object-fit: cover;
    object-position: center;
  }

  header .image + h1 {
    margin-top: 2rem;
  }
</style>
