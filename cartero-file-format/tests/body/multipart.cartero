version = 1
url = "https://www.example.com/login"
method = "POST"

[body]
type = "multipart"

[body.variables]
username = "foo"
password = { value = "bar", active = true, secret = true }
remember_me = { value = "1", active = false, secret = false }
csrf_token = { value = "token", active = false, secret = true }
